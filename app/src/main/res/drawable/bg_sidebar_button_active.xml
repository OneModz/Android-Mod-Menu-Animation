<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#3B4D2A"/>

            <corners android:radius="13dp"/>

            <stroke
                android:width="1dp"
                android:color="#B7FF3C"/>

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#354326"
                android:endColor="#26331D"
                android:type="linear"/>

            <corners android:radius="13dp"/>

            <stroke
                android:width="1dp"
                android:color="#9CFF2E"/>

        </shape>
    </item>

</selector>

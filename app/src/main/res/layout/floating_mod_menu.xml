<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingMenuRoot"
    android:layout_width="320dp"
    android:layout_height="330dp"
    android:orientation="horizontal"
    android:gravity="top"
    android:padding="2dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===================================================== -->
    <!-- PAINEL PRINCIPAL                                      -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/mainPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_menu_panel"
        android:clipChildren="true">

        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <RelativeLayout
            android:id="@+id/menuHeader"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/menuLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="⚽"
                android:textSize="20sp"
                android:textColor="#9CFF2E"
                android:background="@drawable/bg_icon_circle"/>

            <LinearLayout
                android:id="@+id/titleContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/menuLogo"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtMenuTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lą fury"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtProBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="PRO"
                        android:textColor="#121612"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_pro_badge"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtMenuSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Standalone Sandbox"
                    android:textColor="#858C92"
                    android:textSize="9sp"/>

            </LinearLayout>

            <!-- Controles à direita -->

            <LinearLayout
                android:id="@+id/headerControls"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPin"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="0dp"
                    android:text="◎"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_sidebar_button"/>

                <Button
                    android:id="@+id/btnHeaderMinimize"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:padding="0dp"
                    android:text="—"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_sidebar_button"/>

            </LinearLayout>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#303438"/>

        <!-- ================================================= -->
        <!-- ÁREA DINÂMICA DAS ABAS                            -->
        <!-- ================================================= -->

        <FrameLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="7dp"
            android:paddingTop="6dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp"/>

        <!-- ================================================= -->
        <!-- FOOTER                                            -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/footerContainer"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="5dp">

            <Button
                android:id="@+id/btnHide"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="HIDE / KILL"
                android:textColor="#D9DDE0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_pill_button"/>

            <Button
                android:id="@+id/btnFooterMinimize"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:padding="0dp"
                android:text="MINIMIZE"
                android:textColor="#9CFF2E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_pill_button"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Espaço entre painel e sidebar -->

    <Space
        android:layout_width="7dp"
        android:layout_height="match_parent"/>

    <!-- ===================================================== -->
    <!-- SIDEBAR EXTERNA À DIREITA                             -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_sidebar">

        <TextView
            android:id="@+id/sidebarLogo"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⚽"
            android:textSize="19sp"
            android:textColor="#9CFF2E"/>

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:background="#34383C"/>

        <!-- BASIC -->

        <Button
            android:id="@+id/tabBasic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#9CFF2E"
            android:textAllCaps="false"
            android:contentDescription="Basic"
            android:background="@drawable/bg_sidebar_button_active"/>

        <!-- LINES -->

        <Button
            android:id="@+id/tabLines"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:padding="0dp"
            android:text="✎"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:contentDescription="Lines"
            android:background="@drawable/bg_sidebar_button"/>

        <!-- AUTO PLAY -->

        <Button
            android:id="@+id/tabAutoPlay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:padding="0dp"
            android:text="▶"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:contentDescription="Auto Play"
            android:background="@drawable/bg_sidebar_button"/>

        <!-- AUTO QUEUE -->

        <Button
            android:id="@+id/tabAutoQueue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:padding="0dp"
            android:text="♛"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:contentDescription="Auto Queue"
            android:background="@drawable/bg_sidebar_button"/>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- FECHAR -->

        <Button
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:contentDescription="Close"
            android:background="@drawable/bg_sidebar_button"/>

    </LinearLayout>

</LinearLayout>
